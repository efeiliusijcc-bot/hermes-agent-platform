COMPOSE_PROJECT_NAME=hermes-agent-platform
TZ=Asia/Shanghai
APP_ENV=production
LOG_LEVEL=INFO
AGENT_API_BIND_HOST=127.0.0.1
AGENT_API_PORT=18088
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=18089

# PostgreSQL / pgvector
POSTGRES_DB=hermes_agent
POSTGRES_USER=hermes_agent
POSTGRES_PASSWORD=change_me_before_deploy

# Redis
REDIS_PASSWORD=change_me_before_deploy
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=5
AGENT_MEMORY_MAX_TURNS=8
AGENT_MEMORY_TTL_SECONDS=2592000
AGENT_MEMORY_MAX_MESSAGE_CHARS=20000
TASK_QUEUE_KEY=hermes:agent-tasks:v1
TASK_QUEUE_POLL_SECONDS=1
TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_SECONDS=1
TASK_STALE_SECONDS=600
WORKER_ID=agent-worker
WORKER_CONCURRENCY=4
ORCHESTRATOR_POLL_SECONDS=1
AGENT_MESSAGE_STREAM_KEY=hermes:agent-messages:v1
AGENT_MESSAGE_MAX_LENGTH=10000

# MinIO
MINIO_ROOT_USER=hermes_minio
MINIO_ROOT_PASSWORD=change_me_before_deploy

# External OpenAI Compatible model service
MODEL_ENDPOINT=http://model-service.example.internal/v1
MODEL_API_KEY=change_me_before_deploy
MODEL_NAME=qwen-300b
MODEL_GATEWAY_API_KEY=change_me_before_deploy
# Fernet key: generate with `openssl rand -base64 32 | tr '+/' '-_'`.
MODEL_REGISTRY_ENCRYPTION_KEY=replace_with_urlsafe_base64_32_byte_key
# Required only for model create/update/delete/test operations in the console.
MODEL_MANAGEMENT_API_KEY=change_me_before_deploy
CAPABILITY_PLATFORM_ENABLED=false
CAPABILITY_GATEWAY_ENABLED=false
CONSOLE_BFF_ENABLED=false
LEGACY_MCP_BINDING_READ_ENABLED=true
LEGACY_VECTOR_TOOL_ENABLED=true
PLATFORM_MANAGEMENT_API_KEY_ENABLED=true
PLATFORM_MANAGEMENT_API_KEY=change_me_before_deploy
EXECUTION_CAPABILITY_TOKEN_TTL_SECONDS=600
EXECUTION_CAPABILITY_TOKEN_RENEW_BEFORE_SECONDS=120
CAPABILITY_GATEWAY_INTERNAL_URL=http://mcp-gateway:8090/internal/capabilities/invoke
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_CONCURRENCY=5
MODEL_QUEUE_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RETRY_DELAY_SECONDS=1

# Hermes, Pi, and the official DeepSeek Harness bridge. Never store Runtime credentials in runtime_config.
HERMES_API_KEY=change_me_before_deploy
HERMES_TIMEOUT_SECONDS=180
HERMES_RUNTIME_VERSION=0.20.0
PI_RUNTIME_ENDPOINT=http://pi-runtime:8765
PI_RUNTIME_API_KEY=change_me_before_deploy
PI_RUNTIME_TIMEOUT_SECONDS=180
PI_RUNTIME_VERSION=0.84.2
RUNTIME_AUTO_REGISTER=true
PI_RUNTIME_MAX_CONCURRENCY=4
PI_RUNTIME_QUEUE_TIMEOUT_SECONDS=60
PI_RUNTIME_REQUEST_MAX_BYTES=2097152
PI_RUNTIME_SESSION_TTL_SECONDS=1800
PI_RUNTIME_MAX_SESSIONS=1000
PI_RUNTIME_CONTEXT_WINDOW=131072
PI_RUNTIME_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_RUNTIME_ENDPOINT=http://deepseek-runtime:8770
DEEPSEEK_RUNTIME_API_KEY=change_me_before_deploy
DEEPSEEK_RUNTIME_TIMEOUT_SECONDS=900
DEEPSEEK_RUNTIME_VERSION=0.1.0-rc.6
DEEPSEEK_HARNESS_PROVIDER=deepseek-official
DEEPSEEK_RUNTIME_MAX_CONCURRENCY=2
DEEPSEEK_RUNTIME_QUEUE_TIMEOUT_SECONDS=60
DEEPSEEK_RUNTIME_REQUEST_MAX_BYTES=2097152
DEEPSEEK_RUNTIME_MAX_ARTIFACT_BYTES=2097152
DEEPSEEK_RUNTIME_SESSION_TTL_SECONDS=1800
DEEPSEEK_RUNTIME_MAX_SESSIONS=1000
DEEPSEEK_RUNTIME_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_RUNTIME_EXECUTION_UID_MIN=20000
DEEPSEEK_RUNTIME_EXECUTION_UID_MAX=60000

# Skill Loader
SKILL_MAX_DOCUMENT_BYTES=262144
SKILL_MAX_UPLOAD_BYTES=10485760
SKILL_MAX_EXTRACTED_BYTES=52428800
SKILL_MAX_ARCHIVE_ENTRIES=512

# MCP Gateway
MCP_GATEWAY_SIGNING_KEY=change_me_to_at_least_32_random_characters
MCP_ACCESS_TOKEN_TTL_SECONDS=300
MCP_MAX_FILE_BYTES=262144
MCP_MAX_DATABASE_ROWS=100
MCP_DATABASE_STATEMENT_TIMEOUT_MS=5000
MCP_GATEWAY_UID=10001
MCP_GATEWAY_GID=10001
AGENT_API_UID=10002
AGENT_API_GID=10002
WORKSPACE_SHARED_GID=10003

# Artifact Storage: minio (multi-Worker default), local, or nas
ARTIFACT_STORAGE_PROVIDER=minio
ARTIFACT_LOCAL_ROOT=/data/artifacts
ARTIFACT_NAS_ROOT=/data/artifacts
ARTIFACT_MAX_BYTES=104857600
ARTIFACT_MINIO_BUCKET=artifacts
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Memory Storage: redis, postgres, or PostgreSQL pgvector
MEMORY_PROVIDER=redis
MEMORY_TYPE=short-term

# Knowledge Service
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=60
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760

# Controlled source recall. Keep the upstream key only in the gateway service.
SOURCE_RECALL_ENABLED=false
SOURCE_RECALL_GATEWAY_ENDPOINT=http://source-recall-gateway:8082
SOURCE_RECALL_GATEWAY_API_KEY=
SOURCE_RECALL_TIMEOUT_SECONDS=60
SOURCE_RECALL_DEFAULT_LOOKBACK_DAYS=3650
SOURCE_RECALL_DEFAULT_LIMIT=20
SOURCE_RECALL_SUMMARY_MAX_CHARS=1200
SOURCE_RECALL_EXCERPT_MAX_CHARS=2000
SOURCE_RECALL_UPSTREAM_ENDPOINT=
SOURCE_RECALL_UPSTREAM_API_KEY=
SOURCE_RECALL_UPSTREAM_TIMEOUT_SECONDS=60
SOURCE_RECALL_UPSTREAM_MAX_RETRIES=1
SOURCE_RECALL_UPSTREAM_RETRY_DELAY_SECONDS=0.5
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150

# Compose isolation (keep defaults for the primary deployment)
HERMES_COMPOSE_PROJECT_NAME=hermes-agent-platform
HERMES_INTERNAL_NETWORK_NAME=hermes-agent-platform-internal
HERMES_EDGE_NETWORK_NAME=hermes-agent-platform-edge
HERMES_PI_RUNTIME_NETWORK_NAME=hermes-agent-platform-pi-runtime
HERMES_DEEPSEEK_RUNTIME_NETWORK_NAME=hermes-agent-platform-deepseek-runtime
HERMES_DEEPSEEK_HARNESS_NETWORK_NAME=hermes-agent-platform-deepseek-harness

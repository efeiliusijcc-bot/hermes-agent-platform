COMPOSE_PROJECT_NAME=hermes-agent-platform
TZ=Asia/Shanghai
APP_ENV=production
LOG_LEVEL=INFO
AGENT_API_BIND_HOST=127.0.0.1
AGENT_API_PORT=18088

# PostgreSQL / pgvector
POSTGRES_DB=hermes_agent
POSTGRES_USER=hermes_agent
POSTGRES_PASSWORD=change_me_before_deploy

# Redis
REDIS_PASSWORD=change_me_before_deploy

# MinIO
MINIO_ROOT_USER=hermes_minio
MINIO_ROOT_PASSWORD=change_me_before_deploy

# External OpenAI Compatible model service
MODEL_ENDPOINT=http://model-service.example.internal/v1
MODEL_API_KEY=change_me_before_deploy
MODEL_NAME=qwen-300b
MODEL_GATEWAY_API_KEY=change_me_before_deploy
MODEL_TIMEOUT_SECONDS=180

# Hermes Runtime
HERMES_API_KEY=change_me_before_deploy
HERMES_TIMEOUT_SECONDS=180

# Skill Loader
SKILL_MAX_DOCUMENT_BYTES=262144

# MCP Gateway
MCP_GATEWAY_SIGNING_KEY=change_me_to_at_least_32_random_characters
MCP_ACCESS_TOKEN_TTL_SECONDS=300
MCP_MAX_FILE_BYTES=262144
MCP_MAX_DATABASE_ROWS=100
MCP_DATABASE_STATEMENT_TIMEOUT_MS=5000
MCP_GATEWAY_UID=10001
MCP_GATEWAY_GID=10001
